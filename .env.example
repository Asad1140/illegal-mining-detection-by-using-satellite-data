# ===================================================
# Illegal Mining Detection by Using Satellite Data - Environment Configuration
# ===================================================

# Server Settings
PROJECT_NAME="Illegal Mining Detection by Using Satellite Data"
VERSION="1.0.0"
SECRET_KEY="illegal-mining-detection-secret-key-production-change-this"

# Database (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./illegal_mining_detection.db
# DATABASE_URL=postgresql://user:password@localhost:5432/illegal_mining_detection_db

# Satellite Ingestion Adapters (Optional Credentials)
# Leave blank to automatically activate Realistic Demo Mode
SATELLITE_PROVIDER=COPERNICUS_SENTINEL_DEMO
GEE_PROJECT_ID=
COPERNICUS_API_URL=https://dataspace.copernicus.eu/api
NASA_API_KEY=

# GIS Parameters
DEFAULT_BUFFER_DISTANCE_METERS=500.0

# Risk Engine Thresholds
LOW_RISK_MAX=24.0
MEDIUM_RISK_MAX=49.0
HIGH_RISK_MAX=74.0
CRITICAL_RISK_MIN=75.0
